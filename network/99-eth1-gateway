#!/bin/sh
# NetworkManager dispatcher: re-assert the aircraft-network default route on eth1.
#
# Belt-and-suspenders for eth1's NM profile ipv4.gateway setting. On
# 2026-07-24 the Pi came up on the aircraft with an IP on eth1 but no default
# route, breaking the satellite/ground uplink until someone manually ran
# `ip route add default via 10.11.96.1 dev eth1`. If the profile setting ever
# regresses again (bench-testing edits, profile/hardware MAC mismatch after an
# adapter swap, etc.) this script re-adds the route automatically instead of
# requiring someone to notice and fix it by hand. See CLAUDE.md's "Host
# access" section for the network layout this assumes.
#
# Install on the Pi:
#   sudo cp 99-eth1-gateway /etc/NetworkManager/dispatcher.d/99-eth1-gateway
#   sudo chown root:root /etc/NetworkManager/dispatcher.d/99-eth1-gateway
#   sudo chmod 0755 /etc/NetworkManager/dispatcher.d/99-eth1-gateway
#
# NetworkManager calls dispatcher scripts as: <script> <interface> <action>

IFACE="$1"
ACTION="$2"
AIRCRAFT_GW="10.11.96.1"

[ "$IFACE" = "eth1" ] || exit 0
case "$ACTION" in up|dhcp4-change) ;; *) exit 0 ;; esac

# Only touch routing if eth1 actually has an address on the aircraft subnet --
# guards against this firing if the adapter is ever repurposed for something else.
ip -4 addr show dev "$IFACE" | grep -q 'inet 10\.11\.96\.' || exit 0

if ! ip route show default dev "$IFACE" | grep -q "$AIRCRAFT_GW"; then
    logger -t network-eth1-gateway "default route via $AIRCRAFT_GW missing on $IFACE, re-adding"
    ip route replace default via "$AIRCRAFT_GW" dev "$IFACE"
fi
